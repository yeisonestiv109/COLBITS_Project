+import {
+  DEFAULT_LOW_ENERGY_PERCENT,
+  isLowEnergy,
+  lowEnergyThreshold,
+} from './low-energy';
+
+describe('low-energy thresholds (NF-08, CL-11)', () => {
+  it('defaults to the 30 % recommended by Colbits', () => {
+    expect(DEFAULT_LOW_ENERGY_PERCENT).toBe(30);
+    expect(lowEnergyThreshold(undefined)).toBe(30);
+  });
+
+  it('takes a configured percentage', () => {
+    expect(lowEnergyThreshold('45')).toBe(45);
+    expect(lowEnergyThreshold(12.5)).toBe(12.5);
+  });
+
+  it.each(['abc', '0', '-5', '101', ''])(
+    'falls back to the default for an invalid setting (%p)',
+    (value) => {
+      expect(lowEnergyThreshold(value)).toBe(30);
+    },
+  );
+
+  it('a level below the threshold is low; at or above it is not (F-44, F-45)', () => {
+    expect(isLowEnergy(29, 30)).toBe(true);
+    expect(isLowEnergy(30, 30)).toBe(false);
+    expect(isLowEnergy(80, 30)).toBe(false);
+    expect(isLowEnergy(null, 30)).toBeNull();
+  });
+
+  it('NF-08 acceptance: raising the threshold makes a reading between both values low', () => {
+    expect(isLowEnergy(35, lowEnergyThreshold(undefined))).toBe(false);
+    expect(isLowEnergy(35, lowEnergyThreshold('40'))).toBe(true);
+  });
+});
diff --git a/backend/src/device/low-energy.ts b/backend/src/device/low-energy.ts
new file mode 100644
index 0000000..2130a7a
--- /dev/null
+++ b/backend/src/device/low-energy.ts
@@ -0,0 +1,32 @@
+/**
+ * Low device energy (NF-08, F-44, F-45; Scope v6.0 §3.2). Falcon devices keep energy in
+ * supercapacitors (`supercaps_per`) and SMAC devices in a battery (`battery_per`), both percentages
+ * (client answer CL-11). A level below the threshold is low; the client recommends 30 % for both.
+ * The thresholds are settings (NF-08), never hard-coded in the rules that use them.
+ */
+export type DeviceKind = 'FALCON' | 'SMAC';
+
+/** Recommended threshold (CL-11, Colbits, 3 Nov 2026), used when the setting is missing or invalid. */
+export const DEFAULT_LOW_ENERGY_PERCENT = 30;
+
+/** Setting that overrides the threshold of each device type (NF-08). */
+export const LOW_ENERGY_SETTINGS: Readonly<Record<DeviceKind, string>> = {
+  FALCON: 'FALCON_LOW_ENERGY_PERCENT',
+  SMAC: 'SMAC_LOW_ENERGY_PERCENT',
+};
+
+/** A configured percentage when it is a number in (0, 100]; otherwise the recommended default. */
+export function lowEnergyThreshold(configured: unknown): number {
+  const value = Number(configured);
+  return Number.isFinite(value) && value > 0 && value <= 100
+    ? value
+    : DEFAULT_LOW_ENERGY_PERCENT;
+}
+
+/** Whether a stored energy level is low ("falls below the threshold"); null when there is no level. */
+export function isLowEnergy(
+  level: number | null,
+  thresholdPercent: number,
+): boolean | null {
+  return level === null ? null : level < thresholdPercent;
+}
