+} from './dto/inactive-devices.dto';
+import {
+  RecordGap,
+  compareInactiveDevices,
+  inactivityPeriods,
+  isInactiveNow,
+} from './inactivity-periods';
+import {
+  DeviceKind,
+  LOW_ENERGY_SETTINGS,
+  isLowEnergy,
+  lowEnergyThreshold,
+} from './low-energy';
+
+/** Default window of the list (the panel offers "last hour" and "last day") and its upper limit. */
+export const DEFAULT_WINDOW_HOURS = 24;
+export const MAX_WINDOW_HOURS = 30 * 24;
+
+/**
+ * One row per device installed on the in-scope nodes ($1), with its location, latest record, latest
+ * energy level and the gaps between consecutive records that are longer than its threshold.
+ * Records are read inside the window [$2, $3] plus the last one before it, so a silence that began
+ * before the window is still seen. A SMAC record is a record in any of its three tables (TD-07).
+ * $4 / $5: Falcon / SMAC thresholds in hours. Every time is a stored timestamp (F-46).
+ */
+export const INACTIVE_DEVICES_SQL = `
+  WITH dev AS (
+    SELECT 'FALCON'::text AS kind, f.current_hw_id AS hw_id, f.custom_id AS source_id, fs.node_id
+    FROM public.fuses f
+    JOIN public.fuses_sets fs ON fs.id = f.fuses_set_id
+    WHERE fs.node_id = ANY($1) AND f.current_hw_id IS NOT NULL
+    UNION ALL
+    SELECT 'SMAC'::text, t.current_hw_id, t.custom_id, t.node_id
+    FROM public.trafos t
+    WHERE t.node_id = ANY($1) AND t.current_hw_id IS NOT NULL
+  ),
+  rec AS (
+    SELECT d.hw_id, r.recorded_at
+    FROM dev d
+    CROSS JOIN LATERAL (
+      SELECT v.recorded_at FROM public.falcon_values v
+       WHERE d.kind = 'FALCON' AND v.hw_id = d.hw_id
+         AND v.recorded_at >= $2::timestamptz AND v.recorded_at <= $3::timestamptz
+      UNION
+      SELECT v.recorded_at FROM public.smac_vc_values v
+       WHERE d.kind = 'SMAC' AND v.hw_id = d.hw_id
+         AND v.recorded_at >= $2::timestamptz AND v.recorded_at <= $3::timestamptz
+      UNION
+      SELECT v.recorded_at FROM public.smac_pw_values v
+       WHERE d.kind = 'SMAC' AND v.hw_id = d.hw_id
+         AND v.recorded_at >= $2::timestamptz AND v.recorded_at <= $3::timestamptz
+      UNION
+      SELECT v.recorded_at FROM public.smac_pf_values v
+       WHERE d.kind = 'SMAC' AND v.hw_id = d.hw_id
+         AND v.recorded_at >= $2::timestamptz AND v.recorded_at <= $3::timestamptz
+      UNION
+      SELECT b.recorded_at FROM (
+        SELECT CASE WHEN d.kind = 'FALCON' THEN
+                 (SELECT max(recorded_at) FROM public.falcon_values
+                   WHERE hw_id = d.hw_id AND recorded_at < $2::timestamptz)
+               ELSE GREATEST(
+                 (SELECT max(recorded_at) FROM public.smac_vc_values
+                   WHERE hw_id = d.hw_id AND recorded_at < $2::timestamptz),
+                 (SELECT max(recorded_at) FROM public.smac_pw_values
+                   WHERE hw_id = d.hw_id AND recorded_at < $2::timestamptz),
+                 (SELECT max(recorded_at) FROM public.smac_pf_values
+                   WHERE hw_id = d.hw_id AND recorded_at < $2::timestamptz))
+               END AS recorded_at
+      ) b WHERE b.recorded_at IS NOT NULL
+    ) r
+  ),
+  gaps AS (
+    SELECT hw_id, recorded_at AS from_at,
+           LEAD(recorded_at) OVER (PARTITION BY hw_id ORDER BY recorded_at) AS next_at
+    FROM rec
+  )
+  SELECT d.kind, d.hw_id, d.source_id, d.node_id,
+         z.id AS zone_id, z.name AS zone_name,
+         s.id AS substation_id, s.code AS substation_code, s.name AS substation_name,
+         c.id AS circuit_id, c.name AS circuit_name,
+         l.last_at, l.energy,
+         COALESCE(
+           json_agg(json_build_object('from', g.from_at, 'next', g.next_at) ORDER BY g.from_at)
+             FILTER (WHERE g.hw_id IS NOT NULL),
+           '[]'
+         ) AS gaps
+  FROM dev d
+  JOIN public.nodes n ON n.name = d.node_id
+  JOIN public.circuits c ON c.id = n.circuit_id
+  JOIN public.substations s ON s.id = c.substation_id
+  JOIN public.zones z ON z.id = s.zone_id
+  CROSS JOIN LATERAL (
+    SELECT CASE WHEN d.kind = 'FALCON' THEN
+             (SELECT recorded_at FROM public.last_falcon_values WHERE hw_id = d.hw_id)
+           ELSE GREATEST(
+             (SELECT recorded_at FROM public.last_smac_vc_values WHERE hw_id = d.hw_id),
+             (SELECT recorded_at FROM public.last_smac_pw_values WHERE hw_id = d.hw_id),
+             (SELECT recorded_at FROM public.last_smac_pf_values WHERE hw_id = d.hw_id))
+           END AS last_at,
+           CASE WHEN d.kind = 'FALCON' THEN
+             (SELECT supercaps_per FROM public.last_falcon_values WHERE hw_id = d.hw_id)
+           ELSE
+             (SELECT battery_per FROM public.last_smac_vc_values WHERE hw_id = d.hw_id)
+           END AS energy
+  ) l
+  LEFT JOIN gaps g
+    ON g.hw_id = d.hw_id
+   AND COALESCE(g.next_at, $3::timestamptz) - g.from_at
+       > (CASE d.kind WHEN 'FALCON' THEN $4::float8 ELSE $5::float8 END) * interval '1 hour'
+  GROUP BY d.kind, d.hw_id, d.source_id, d.node_id, z.id, z.name, s.id, s.code, s.name,
+           c.id, c.name, l.last_at, l.energy
+`;
+
+interface InactiveDeviceRow {
+  kind: DeviceKind;
+  hw_id: string;
+  source_id: string;
+  node_id: string;
+  zone_id: number | string;
+  zone_name: string;
+  substation_id: number | string;
+  substation_code: string;
+  substation_name: string;
+  circuit_id: number | string;
+  circuit_name: string;
+  last_at: Date | string | null;
+  energy: number | string | null;
+  gaps: { from: string; next: string | null }[] | string;
+}
+
+/** US17 · F-38, F-39, F-40 (+ NF-08): inactive devices of the user scope with their inactivity alarms. */
+@Injectable()
+export class InactiveDevicesService {
+  constructor(
+    @InjectRepository(Node)
+    private readonly nodesRepository: Repository<Node>,
+    private readonly configService: ConfigService,
+  ) {}
+
+  async inactiveDevices(
+    scope: ScopeContext,
+    windowHours: number = DEFAULT_WINDOW_HOURS,
+    now: Date = new Date(),
+  ): Promise<InactiveDevicesResponseDto> {
+    const from = new Date(now.getTime() - windowHours * 3_600_000);
+    const thresholds = {
+      falcon_inactivity_hours: this.hours('FALCON_INACTIVITY_HOURS', 9),
+      smac_inactivity_hours: this.hours('SMAC_INACTIVITY_HOURS', 3),
+      falcon_low_energy_percent: lowEnergyThreshold(
+        this.configService.get(LOW_ENERGY_SETTINGS.FALCON),
+      ),
+      smac_low_energy_percent: lowEnergyThreshold(
+        this.configService.get(LOW_ENERGY_SETTINGS.SMAC),
+      ),
+    };
+    const envelope = {
+      from: from.toISOString(),
+      to: now.toISOString(),
+      thresholds,
+    };
+
+    // Scope in SQL, as every other endpoint (F-10): only the user's nodes are read.
+    const nodesQuery = this.nodesRepository
+      .createQueryBuilder('node')
+      .select(['node.name']);
+    applyNodeScope(nodesQuery, 'node.name', scope);
+    const nodeNames = (await nodesQuery.getMany()).map((node) => node.name);
+    if (nodeNames.length === 0) return { ...envelope, count: 0, devices: [] };
+
+    const rows: InactiveDeviceRow[] = await this.nodesRepository.query(
+      INACTIVE_DEVICES_SQL,
+      [
+        nodeNames,
+        from.toISOString(),
+        now.toISOString(),
+        thresholds.falcon_inactivity_hours,
+        thresholds.smac_inactivity_hours,
+      ],
+    );
+
+    const devices = rows
+      .map((row) => toDevice(row, thresholds, from, now))
+      .filter((device) => device.periods.length > 0 || device.inactive_now)
+      .sort((a, b) => compareInactiveDevices(orderKey(a), orderKey(b)));
+
+    return { ...envelope, count: devices.length, devices };
+  }
+
+  /** Same rule as the other services: a positive number of hours from the config, or the default. */
+  private hours(key: string, fallback: number): number {
+    const configured = Number(this.configService.get(key));
+    return Number.isFinite(configured) && configured > 0
+      ? configured
+      : fallback;
+  }
+}
+
+function toDevice(
+  row: InactiveDeviceRow,
+  thresholds: InactiveDevicesResponseDto['thresholds'],
+  from: Date,
+  now: Date,
+): InactiveDeviceDto {
+  const falcon = row.kind === 'FALCON';
+  const thresholdHours = falcon
+    ? thresholds.falcon_inactivity_hours
+    : thresholds.smac_inactivity_hours;
+  const lastRecordAt = row.last_at === null ? null : new Date(row.last_at);
+  const rawGaps =
+    typeof row.gaps === 'string' ? JSON.parse(row.gaps) : row.gaps;
+  const gaps: RecordGap[] = (
+    rawGaps as { from: string; next: string | null }[]
+  ).map((gap) => ({
+    from: new Date(gap.from),
+    next: gap.next === null ? null : new Date(gap.next),
+  }));
+  const energy = row.energy === null ? null : Number(row.energy);
+
+  return {
+    hw_id: row.hw_id,
+    source_id: row.source_id,
+    kind: row.kind,
+    node: row.node_id,
+    zone: { id: Number(row.zone_id), name: row.zone_name },
+    substation: {
+      id: Number(row.substation_id),
+      code: row.substation_code,
+      name: row.substation_name,
+    },
+    circuit: { id: Number(row.circuit_id), name: row.circuit_name },
+    threshold_hours: thresholdHours,
+    last_record_at: lastRecordAt?.toISOString() ?? null,
+    inactive_now: isInactiveNow(lastRecordAt, thresholdHours, now),
+    energy_percent: energy,
+    low_energy: isLowEnergy(
+      energy,
+      falcon
+        ? thresholds.falcon_low_energy_percent
+        : thresholds.smac_low_energy_percent,
+    ),
+    periods: inactivityPeriods(gaps, thresholdHours, from, now).map((p) => ({
+      start: p.start.toISOString(),
+      end: p.end?.toISOString() ?? null,
+    })),
+  };
+}
+
+const orderKey = (device: InactiveDeviceDto) => ({
+  hwId: device.hw_id,
+  inactiveNow: device.inactive_now,
+  lastRecordAt:
+    device.last_record_at === null ? null : new Date(device.last_record_at),
+  periods: device.periods.map((p) => ({
+    start: new Date(p.start),
+    end: p.end === null ? null : new Date(p.end),
+  })),
+});
diff --git a/backend/src/device/inactivity-periods.spec.ts b/backend/src/device/inactivity-periods.spec.ts
new file mode 100644
index 0000000..afb69ce
--- /dev/null
+++ b/backend/src/device/inactivity-periods.spec.ts
@@ -0,0 +1,158 @@
+import {
+  compareInactiveDevices,
+  inactivityPeriods,
+  isInactiveNow,
+} from './inactivity-periods';
+
+const at = (iso: string) => new Date(iso);
+const H = 3_600_000;
+const NOW = at('2026-11-12T00:00:00Z');
+const DAY_AGO = new Date(NOW.getTime() - 24 * H);
+
+describe('inactivityPeriods (US17 · F-38, F-39, F-42)', () => {
+  it('F-42 example: records at 00:00 and 20:00 give one period from 09:00 to 20:00', () => {
+    const periods = inactivityPeriods(
+      [
+        { from: at('2026-11-11T00:00:00Z'), next: at('2026-11-11T20:00:00Z') },
+        { from: at('2026-11-11T20:00:00Z'), next: at('2026-11-11T20:15:00Z') },
+      ],
+      9,
+      DAY_AGO,
+      NOW,
+    );
+
+    expect(periods).toEqual([
+      { start: at('2026-11-11T09:00:00Z'), end: at('2026-11-11T20:00:00Z') },
+    ]);
+  });
+
+  it('F-38: a device silent for longer than its threshold has an open alarm', () => {
+    const periods = inactivityPeriods(
+      [{ from: at('2026-11-11T12:00:00Z'), next: null }],
+      9,
+      DAY_AGO,
+      NOW,
+    );
+
+    expect(periods).toEqual([{ start: at('2026-11-11T21:00:00Z'), end: null }]);
+  });
+
+  it('F-39: the alarm resolves with the timestamp of the record that ends the silence', () => {
+    const [period] = inactivityPeriods(
+      [{ from: at('2026-11-11T12:00:00Z'), next: at('2026-11-11T23:30:00Z') }],
+      9,
+      DAY_AGO,
+      NOW,
+    );
+
+    expect(period.end).toEqual(at('2026-11-11T23:30:00Z'));
+  });
+
+  it('F-36 / F-37 boundary: a gap exactly equal to the threshold is not inactivity', () => {
+    expect(
+      inactivityPeriods(
+        [
+          {
+            from: at('2026-11-11T12:00:00Z'),
+            next: at('2026-11-11T15:00:00Z'),
+          },
+        ],
+        3,
+        DAY_AGO,
+        NOW,
+      ),
+    ).toEqual([]);
+    expect(
+      inactivityPeriods(
+        [
+          {
+            from: at('2026-11-11T12:00:00Z'),
+            next: at('2026-11-11T15:01:00Z'),
+          },
+        ],
+        3,
+        DAY_AGO,
+        NOW,
+      ),
+    ).toHaveLength(1);
+  });
+
+  it('a silent device that has not yet reached its threshold has no alarm', () => {
+    expect(
+      inactivityPeriods(
+        [{ from: at('2026-11-11T22:00:00Z'), next: null }],
+        3,
+        DAY_AGO,
+        NOW,
+      ),
+    ).toEqual([]);
+  });
+
+  it('keeps a period that started before the window and drops one that ended before it', () => {
+    const periods = inactivityPeriods(
+      [
+        { from: at('2026-11-09T00:00:00Z'), next: at('2026-11-10T00:00:00Z') },
+        { from: at('2026-11-10T06:00:00Z'), next: at('2026-11-11T06:00:00Z') },
+      ],
+      9,
+      DAY_AGO,
+      NOW,
+    );
+
+    expect(periods).toEqual([
+      { start: at('2026-11-10T15:00:00Z'), end: at('2026-11-11T06:00:00Z') },
+    ]);
+  });
+});
+
+describe('isInactiveNow (F-36, F-37)', () => {
+  it('is true without records or past the threshold', () => {
+    expect(isInactiveNow(null, 9, NOW)).toBe(true);
+    expect(isInactiveNow(at('2026-11-11T14:59:00Z'), 9, NOW)).toBe(true);
+    expect(isInactiveNow(at('2026-11-11T15:01:00Z'), 9, NOW)).toBe(false);
+  });
+});
+
+describe('compareInactiveDevices (F-40 order)', () => {
+  const key = (
+    hwId: string,
+    inactiveNow: boolean,
+    lastRecordAt: string | null,
+    lastEnd: string | null = null,
+  ) => ({
+    hwId,
+    inactiveNow,
+    lastRecordAt: lastRecordAt === null ? null : at(lastRecordAt),
+    periods: lastEnd ? [{ start: at(lastEnd), end: at(lastEnd) }] : [],
+  });
+
+  it('F-40 acceptance: last records 30, 12 and 4 hours old appear in that order', () => {
+    const devices = [
+      key('C', true, '2026-11-11T20:00:00Z'),
+      key('A', true, '2026-11-10T18:00:00Z'),
+      key('B', true, '2026-11-11T12:00:00Z'),
+    ];
+
+    expect(devices.sort(compareInactiveDevices).map((d) => d.hwId)).toEqual([
+      'A',
+      'B',
+      'C',
+    ]);
+  });
+
+  it('puts a device that never reported first, and devices that reported again last', () => {
+    const devices = [
+      key('back-old', false, '2026-11-11T23:00:00Z', '2026-11-11T10:00:00Z'),
+      key('silent', true, '2026-11-11T10:00:00Z'),
+      key('back-new', false, '2026-11-11T23:00:00Z', '2026-11-11T20:00:00Z'),
+      key('never', true, null),
+    ];
+
+    expect(devices.sort(compareInactiveDevices).map((d) => d.hwId)).toEqual([
+      'never',
+      'silent',
+      'back-new',
+      'back-old',
+    ]);
+  });
+});
diff --git a/backend/src/device/inactivity-periods.ts b/backend/src/device/inactivity-periods.ts
new file mode 100644
index 0000000..3f8aec2
--- /dev/null
+++ b/backend/src/device/inactivity-periods.ts
@@ -0,0 +1,94 @@
+/**
+ * Inactivity periods and the inactivity alarm (US17 · F-38, F-39, F-40; Scope v6.0 §3.2, §3.3).
+ *
+ * Inactivity is derived from the absence of records; the device never reports it. A device whose
+ * next record comes more than its threshold after the previous one (or that has not reported for
+ * more than the threshold) was inactive from `previous record + threshold` (the moment it is
+ * declared inactive) until its next record. That period IS the device's inactivity alarm:
+ *   F-38  it opens when the device passes its threshold (open period, `end: null`);
+ *   F-39  it resolves by itself when the device stores a new record, with the end taken from that
+ *         record's stored timestamp (F-46), so nobody closes it by hand.
+ * Example from the F-42 acceptance test: Falcon records at 00:00 and 20:00, threshold 9 h →
+ * one period from 09:00 to 20:00.
+ */
+import type { DeviceKind } from './low-energy';
+
+const HOUR_MS = 3_600_000;
+
+/** Consecutive records of one device, as the SQL returns them: `next` is null for the last one. */
+export interface RecordGap {
+  from: Date;
+  next: Date | null;
+}
+
+export interface InactivityPeriod {
+  start: Date;
+  /** null while the device is still silent: the inactivity alarm is open. */
+  end: Date | null;
+}
+
+/**
+ * Inactivity periods of one device that touch the window [windowStart, now]. A gap counts only when
+ * it is longer than the threshold ("more than 9 hours", F-36 / F-37), never when it is equal.
+ */
+export function inactivityPeriods(
+  gaps: readonly RecordGap[],
+  thresholdHours: number,
+  windowStart: Date,
+  now: Date,
+): InactivityPeriod[] {
+  const threshold = thresholdHours * HOUR_MS;
+  return gaps
+    .filter(
+      (gap) => (gap.next ?? now).getTime() - gap.from.getTime() > threshold,
+    )
+    .map((gap) => ({
+      start: new Date(gap.from.getTime() + threshold),
+      end: gap.next,
+    }))
+    .filter((period) => (period.end ?? now).getTime() > windowStart.getTime())
+    .sort((a, b) => a.start.getTime() - b.start.getTime());
+}
+
+/** Inactive now (F-36 / F-37): no record at all, or the last one older than the threshold. */
+export function isInactiveNow(
+  lastRecordAt: Date | null,
+  thresholdHours: number,
+  now: Date,
+): boolean {
+  return (
+    lastRecordAt === null ||
+    now.getTime() - lastRecordAt.getTime() > thresholdHours * HOUR_MS
+  );
+}
+
+export interface InactiveDeviceOrderKey {
+  hwId: string;
+  inactiveNow: boolean;
+  lastRecordAt: Date | null;
+  periods: readonly InactivityPeriod[];
+}
+
+/**
+ * F-40 order: devices inactive now first, from the oldest last record to the most recent (a device
+ * that never reported comes first); then devices that already reported again, the most recently
+ * resolved first. Ties by hardware id, so the order is stable.
+ */
+export function compareInactiveDevices(
+  a: InactiveDeviceOrderKey,
+  b: InactiveDeviceOrderKey,
+): number {
+  if (a.inactiveNow !== b.inactiveNow) return a.inactiveNow ? -1 : 1;
+  const byTime = a.inactiveNow
+    ? timeOf(a.lastRecordAt) - timeOf(b.lastRecordAt)
+    : lastEnd(b) - lastEnd(a);
+  return byTime || a.hwId.localeCompare(b.hwId);
+}
+
+const timeOf = (date: Date | null): number =>
+  date === null ? Number.NEGATIVE_INFINITY : date.getTime();
+
+const lastEnd = (key: InactiveDeviceOrderKey): number =>
+  Math.max(...key.periods.map((p) => p.end?.getTime() ?? 0), 0);
+
+export type { DeviceKind };
