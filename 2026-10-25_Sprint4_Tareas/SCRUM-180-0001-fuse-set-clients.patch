+
+    const rows: FuseSetRow[] = await this.nodesRepository.query(
+      NODE_FUSE_SETS_SQL,
+      [nodeName],
+    );
+
+    const fuseSets: FuseSetViewDto[] = rows.map((row) => ({
+      id: Number(row.id),
+      set_id: row.set_id,
+      client_count: row.client_count === null ? null : Number(row.client_count),
+    }));
+
+    return { node: nodeName, fuse_sets: fuseSets };
+  }
