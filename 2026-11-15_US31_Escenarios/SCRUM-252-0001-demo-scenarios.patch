@@ -0,0 +1,62 @@
+import { ForbiddenException, UnauthorizedException } from '@nestjs/common';
+import type { Request } from 'express';
+import { ScopeService } from '../scope/scope.service';
+import { ScenariosController } from './scenarios.controller';
+import { ScenariosService } from './scenarios.service';
+
+function controllerWith() {
+  const resolve = jest.fn().mockResolvedValue({ kind: 'unrestricted' });
+  const run = jest.fn().mockResolvedValue({ action: 'OPEN_FUSE' });
+  const status = jest.fn().mockReturnValue({ enabled: true, actions: [] });
+  const controller = new ScenariosController(
+    { run, status } as unknown as ScenariosService,
+    { resolve } as unknown as ScopeService,
+  );
+  return { controller, resolve, run, status };
+}
+
+const requestFor = (user?: Record<string, unknown>) =>
+  ({ user }) as unknown as Request;
+const BODY = { action: 'OPEN_FUSE', target: '0000100002-A-R' } as const;
+
+describe('ScenariosController (US31 · F-100)', () => {
+  it('GET returns the demo-mode status', () => {
+    const { controller, status } = controllerWith();
+
+    expect(controller.status()).toEqual({ enabled: true, actions: [] });
+    expect(status).toHaveBeenCalled();
+  });
+
+  it('POST runs the scenario in the scope of the administrator in the token', async () => {
+    const { controller, resolve, run } = controllerWith();
+
+    await controller.run(
+      BODY,
+      requestFor({ sub: 1, role: 'Colbits administrator' }),
+    );
+
+    expect(resolve).toHaveBeenCalledWith(1);
+    expect(run).toHaveBeenCalledWith(BODY, { kind: 'unrestricted' });
+  });
+
+  it('POST refuses a consultation user', async () => {
+    const { controller, run } = controllerWith();
+
+    await expect(
+      controller.run(BODY, requestFor({ sub: 2, role: 'consultation user' })),
+    ).rejects.toThrow(ForbiddenException);
+    expect(run).not.toHaveBeenCalled();
+  });
+
+  it('POST refuses a token without a valid user id', async () => {
+    const { controller, run } = controllerWith();
+
+    await expect(
+      controller.run(
+        BODY,
+        requestFor({ sub: '1', role: 'Colbits administrator' }),
+      ),
+    ).rejects.toThrow(UnauthorizedException);
+    expect(run).not.toHaveBeenCalled();
+  });
+});
diff --git a/backend/src/scenarios/scenarios.controller.ts b/backend/src/scenarios/scenarios.controller.ts
new file mode 100644
index 0000000..915a4e7
--- /dev/null
+++ b/backend/src/scenarios/scenarios.controller.ts
@@ -0,0 +1,109 @@
+import {
+  Body,
+  Controller,
+  ForbiddenException,
+  Get,
+  HttpCode,
+  Post,
+  Req,
+  UnauthorizedException,
+  UseGuards,
+} from '@nestjs/common';
+import type { Request } from 'express';
+import {
+  ApiBadRequestResponse,
+  ApiBearerAuth,
+  ApiConflictResponse,
+  ApiCreatedResponse,
+  ApiForbiddenResponse,
+  ApiNotFoundResponse,
+  ApiOkResponse,
+  ApiOperation,
+  ApiTags,
+  ApiUnauthorizedResponse,
+} from '@nestjs/swagger';
+import { AuthGuard } from '../auth/auth.guard';
+import { RolesGuard } from '../auth/roles.guard';
+import { ErrorResponseDto } from '../common/dto/error-response.dto';
+import { ScopeService } from '../scope/scope.service';
+import {
+  RunScenarioDto,
+  ScenarioResultDto,
+  ScenariosStatusDto,
+} from './dto/scenarios.dto';
+import { ScenariosService } from './scenarios.service';
+
+const ADMIN_ROLE = 'Colbits administrator';
+
+@Controller('scenarios')
+@UseGuards(AuthGuard, RolesGuard)
+@ApiTags('scenarios')
+@ApiBearerAuth()
+export class ScenariosController {
+  constructor(
+    private readonly scenariosService: ScenariosService,
+    private readonly scopeService: ScopeService,
+  ) {}
+
+  @Get()
+  @ApiOperation({
+    summary: 'Demo mode and the scenarios it offers (US31 · F-100).',
+    description:
+      'enabled is true only where DEMO_SCENARIOS_ENABLED=true (never in production, NF-03). The frontend shows the scenario panel only when enabled is true.',
+  })
+  @ApiOkResponse({ type: ScenariosStatusDto })
+  @ApiUnauthorizedResponse({ type: ErrorResponseDto })
+  status() {
+    return this.scenariosService.status();
+  }
+
+  @Post()
+  @HttpCode(201)
+  @ApiOperation({
+    summary:
+      'Run a demo scenario: open or close a fuse, cut or restore voltage, drop or restore a transformer phase (US31 · F-100).',
+    description:
+      'Writes what the device would send: one telemetry reading (falcon_values or smac_vc_values) and one alarm event with the Technical Annex §4.2 code (13xx20, 13xx21, 05xx21y), SET or CLEAR, both stamped now. The map, GET /faults and the node detail then react through their normal rules on the next refresh. Only for Colbits administrators, inside their scope, and only in demo mode. An action that would repeat the current state (opening an open fuse) is refused with 409.',
+  })
+  @ApiCreatedResponse({ type: ScenarioResultDto })
+  @ApiBadRequestResponse({
+    type: ErrorResponseDto,
+    description:
+      'Unknown action, missing target, channel missing or not allowed, the device or channel does not exist.',
+  })
+  @ApiUnauthorizedResponse({ type: ErrorResponseDto })
+  @ApiForbiddenResponse({
+    type: ErrorResponseDto,
+    description:
+      'Demo mode is off, or the user is not a Colbits administrator.',
+  })
+  @ApiNotFoundResponse({
+    type: ErrorResponseDto,
+    description: 'Target not found, or outside the user scope.',
+  })
+  @ApiConflictResponse({
+    type: ErrorResponseDto,
+    description: 'The target is already in the state the action would set.',
+  })
+  async run(@Body() body: RunScenarioDto, @Req() request: Request) {
+    const user = (
+      request as Request & { user?: { sub?: unknown; role?: unknown } }
+    ).user;
+    const userId = user?.sub;
+    if (
+      typeof userId !== 'number' ||
+      !Number.isSafeInteger(userId) ||
+      userId <= 0
+    ) {
+      throw new UnauthorizedException('Invalid user identity');
+    }
+    if (user?.role !== ADMIN_ROLE) {
+      throw new ForbiddenException(
+        'Only Colbits administrators can run demo scenarios',
+      );
+    }
+
+    const scope = await this.scopeService.resolve(userId);
+    return this.scenariosService.run(body, scope);
+  }
+}
